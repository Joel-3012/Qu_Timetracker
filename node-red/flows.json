    {
        "id": "map_and_store",
        "type": "function",
        "z": "5bdfd708dfdb7e64",
        "name": "Projekt- & Task-Mapping speichern",
        "func": "let projektMap = {};\nlet activityMap = {};\n\n// Prüfen, ob Hakuna überhaupt ein Array geliefert hat\nif (!Array.isArray(msg.payload)) {\n    node.error(\"❌ Hakuna hat keine Projektliste geliefert.\");\n    node.warn(msg.payload);\n    return null;\n}\n\nlet aktiveProjekte = 0;\nlet aktiveTasks = 0;\n\nfor (const projekt of msg.payload) {\n\n    // Nur aktive Projekte\n    if (projekt.archived === true) {\n        continue;\n    }\n\n    aktiveProjekte++;\n\n    // Projekt speichern\n    if (projekt.name && projekt.id) {\n        projektMap[projekt.name] = projekt.id;\n    }\n\n    // Tasks des Projekts durchgehen\n    for (const task of (projekt.tasks || [])) {\n\n        // Archivierte Tasks ebenfalls überspringen\n        if (task.archived === true) {\n            continue;\n        }\n\n        if (!task.name || !task.id) {\n            continue;\n        }\n\n        // Gleichen Tasknamen nur einmal speichern\n        if (!activityMap[task.name]) {\n            activityMap[task.name] = task.id;\n            aktiveTasks++;\n        }\n    }\n}\n\n// Global speichern\nglobal.set(\"projektMap\", projektMap);\nglobal.set(\"activityMap\", activityMap);\n\n// Debug-Ausgabe\nnode.warn(\"================================\");\nnode.warn(\"✅ Hakuna Mapping aktualisiert\");\nnode.warn(\"📁 Aktive Projekte: \" + aktiveProjekte);\nnode.warn(\"🔧 Eindeutige aktive Tasks: \" + aktiveTasks);\nnode.warn(\"📋 Tasks:\");\nnode.warn(\n    Object.keys(activityMap)\n        .sort((a, b) => a.localeCompare(b, \"de\"))\n);\nnode.warn(\"================================\");\n\n// Für normalen Debug-Node\nmsg.projektMap = projektMap;\nmsg.activityMap = activityMap;\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 640,
        "y": 520,
        "wires": [
