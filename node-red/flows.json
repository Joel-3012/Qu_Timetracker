        "z": "5bdfd708dfdb7e64",
        "name": "Commit: JSON für /zeitrapport",
        "func": "const sel = flow.get(\"companion_selection\") || {};\nconst body = msg.req?.body || msg.payload || {};\nconst minutes = parseInt(body.minutes || body.Time, 10);\nif (!sel.project || !sel.task || isNaN(minutes)) {\n  msg.statusCode = 400;\n  msg.payload = { ok:false, error:\"Projekt/Task/Minuten unvollständig\" };\n  return msg;\n}\n// lokalen POST auf deinen vorhandenen Flow /zeitrapport\nmsg.method = 'POST';\nmsg.url = 'http://127.0.0.1:1880/zeitrapport';\nmsg.headers = { 'Content-Type':'application/json' };\nmsg.payload = { Project: sel.project, task: sel.task, Time: String(minutes) };\nreturn msg;",
