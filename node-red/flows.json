        "name": "Auswahl: Projekt speichern",
        "func": "// Erlaubt { index } oder { name }\nconst body = msg.req?.body || msg.payload || {};\nconst map = global.get(\"projektMap\") || {};\nconst names = Object.keys(map).sort((a,b)=>a.localeCompare(b,'de'));\nlet name = body.name;\nif (!name && body.index) {\n  const i = parseInt(body.index, 10);\n  if (!isNaN(i) && i>=1 && i<=names.length) name = names[i-1];\n}\nif (!name || !map[name]) {\n  msg.statusCode = 400;\n  msg.payload = { ok:false, error:\"Projekt nicht gefunden\" };\n  return msg;\n}\nflow.set(\"companion_selection\", Object.assign({}, flow.get(\"companion_selection\")||{}, { project:name }));\nmsg.payload = { ok:true, project:name };\nreturn msg;",
