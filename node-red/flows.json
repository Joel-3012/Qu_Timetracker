        "id": "fn_select_task",
        "type": "function",
        "z": "5bdfd708dfdb7e64",
        "name": "Auswahl: Task speichern",
        "func": "// Erlaubt { index } oder { name }\nconst body = msg.req?.body || msg.payload || {};\nconst map = global.get(\"activityMap\") || {};\nconst names = Object.keys(map).sort((a,b)=>a.localeCompare(b,'de'));\nlet name = body.name;\nif (!name && body.index) {\n  const i = parseInt(body.index, 10);\n  if (!isNaN(i) && i>=1 && i<=names.length) name = names[i-1];\n}\nif (!name || !map[name]) {\n  msg.statusCode = 400;\n  msg.payload = { ok:false, error:\"Task nicht gefunden\" };\n  return msg;\n}\nflow.set(\"companion_selection\", Object.assign({}, flow.get(\"companion_selection\")||{}, { task:name }));\nmsg.payload = { ok:true, task:name };\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "x": 490,
        "y": 1080,
        "wires": [
            [
                "http_res_select_task"
            ]
