    {
        "id": "prepare_new_entry",
        "type": "function",
        "z": "5bdfd708dfdb7e64",
        "name": "Zeitblock & Mapping",
        "func": "// Zeitblock & Mapping (final)\n\n// Maps laden\nconst projektMap = global.get(\"projektMap\") || {};\nconst activityMap = global.get(\"activityMap\") || {};\n\n// Companion-Body sicher holen (aus \"Eingabe sichern\")\nconst body = (msg.originalData && typeof msg.originalData === 'object')\n    ? msg.originalData\n    : (msg.req?.body || {});\n\n// Minuten parsen (Time|time|minutes)\nconst timeRaw = body.Time ?? body.time ?? body.minutes;\nconst dauerMin = Number.parseInt(String(timeRaw || '').trim(), 10);\nif (!Number.isFinite(dauerMin) || dauerMin <= 0) {\n    msg.statusCode = 400;\n    msg.headers = { \"Content-Type\": \"text/plain; charset=utf-8\" };\n    msg.payload = \"⚠️ Fehler: Time (Minuten) ist ungültig.\";\n    return msg;\n}\n\n// Einträge (heute) aus vorherigem HTTP-Request\nconst entries = Array.isArray(msg.payload) ? msg.payload : [];\n\n// letzte Endzeit bestimmen (Fallback heute 07:00 lokale Zeit)\nconst now = new Date();\nconst fallbackStart = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 7, 0, 0);\nlet letzteEndzeit = fallbackStart;\n\nfor (const e of entries) {\n    if (e && e.date && e.end_time) {\n        const [Y, M, D] = String(e.date).split('-').map(Number);\n        const [h, m] = String(e.end_time).split(':').map(Number);\n        const dt = new Date(Y, M - 1, D, h, m || 0, 0, 0); // lokale Zeit\n        if (!isNaN(dt.getTime()) && dt > letzteEndzeit) letzteEndzeit = dt;\n    }\n}\n\n// neuen Block berechnen\nconst start = new Date(letzteEndzeit);\nconst end = new Date(start.getTime() + dauerMin * 60000);\nif (isNaN(start.getTime()) || isNaN(end.getTime())) {\n    msg.statusCode = 400;\n    msg.headers = { \"Content-Type\": \"text/plain; charset=utf-8\" };\n    msg.payload = \"⚠️ Fehler: Zeitdaten konnten nicht berechnet werden.\";\n    return msg;\n}\n\n// Format yyyy-mm-dd / HH:MM\nconst pad = n => String(n).padStart(2, '0');\nconst dateStr = `${start.getFullYear()}-${pad(start.getMonth() + 1)}-${pad(start.getDate())}`;\nconst startStr = `${pad(start.getHours())}:${pad(start.getMinutes())}`;\nconst endStr = `${pad(end.getHours())}:${pad(end.getMinutes())}`;\n\n// IDs mappen\nconst projectId = projektMap[body.Project];\nconst taskId = activityMap[body.task];\nif (!projectId || !taskId) {\n    msg.statusCode = 400;\n    msg.headers = { \"Content-Type\": \"text/plain; charset=utf-8\" };\n    msg.payload = \"⚠️ Fehler: Projekt/Task nicht gemappt.\";\n    return msg;\n}\n\n// Finaler Payload für Hakuna POST\nmsg.payload = {\n    date: dateStr,\n    start_time: startStr,\n    end_time: endStr,\n    project_id: projectId,\n    task_id: taskId\n};\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
